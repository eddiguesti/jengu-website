---
/**
 * FAQ : one accordion. The `faqs` array feeds both the markup and the
 * FAQPage schema so the two cannot drift.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema, generateFAQSchema } from '../lib/seo/jsonld';

type Faq = { q: string; a: string; link?: { href: string; label: string } };

const faqs: Faq[] = [
  {
    q: 'What is an AI agent?',
    a: 'Software that reads a message, works out what is being asked and acts on it. In a hotel or holiday park that means answering guest questions, taking and changing bookings, and doing the admin around them. Agents run around the clock, hold many conversations at once and improve from the corrections your team makes.',
  },
  {
    q: 'Who do you help?',
    a: 'Tourism and hospitality businesses: hotels, resorts and boutique properties, campsites and holiday parks, travel agencies and tour operators, destination management companies, B&Bs and guesthouses, and holiday rental managers. If your team spends its day on enquiries, bookings and admin, we can help.',
  },
  {
    q: 'What tasks can AI agents automate?',
    a: 'Guest communication over chat, email, SMS and phone. Bookings, changes and cancellations. Questions about prices, availability, policies and the local area. Sorting and answering email. Picking out the enquiries worth a person’s time. Data entry, reports and calendar admin. Reminders, confirmations and feedback requests. All of it in 100+ languages.',
  },
  {
    q: 'How long does setup take?',
    a: 'A simple chatbot takes two to three weeks, covering consultation, training, testing and launch. An email agent takes three to four weeks, including process mapping and integration. Custom software takes six to twelve weeks. A full suite of agents takes eight to sixteen weeks. We work in phases, so the first pieces go live while we build the rest.',
  },
  {
    q: 'Do AI agents replace human staff?',
    a: 'No. The agents take the repetitive work: routine questions, standard bookings, sorting email and instant replies to common enquiries. Your team keeps the work that needs judgement and a human touch, such as difficult problems, personal requests and relationships with regular guests.',
  },
  {
    q: 'How do you measure ROI?',
    a: 'We track hours saved on admin each week, how quickly guests get a reply, how many enquiries turn into bookings, staff time spent on routine work, extra bookings from being reachable at night and weekends, and guest satisfaction scores. For an estimate based on your own numbers, use the calculator at /calculator.',
    link: { href: '/calculator', label: 'Open the calculator' },
  },
  {
    q: 'What if the AI makes a mistake?',
    a: 'Every agent has limits we set with you during setup, so it knows what it can and cannot do. When it is unsure it hands over to a person. Cancellations, refunds and policy exceptions always go to your team. It learns from corrections, and we test it thoroughly before it talks to a real guest. You can review any conversation and change how it answers.',
  },
  {
    q: 'How much does it cost?',
    a: 'It depends on what we build. The options are a chatbot, email automation, custom software or a full automation suite, and each is priced on its scope. Book a free call and we will quote for your business. For a rough idea of what automation could save you first, use the calculator at /calculator.',
    link: { href: '/calculator', label: 'Open the calculator' },
  },
  {
    q: 'Can AI handle multiple languages?',
    a: 'Yes. The agents work in 100+ languages. They detect the language a guest writes in and reply in the same one, so you do not need multilingual staff for routine enquiries, and the quality is the same in every language. That matters most if you host international travellers.',
  },
  {
    q: 'What integrations do you support?',
    a: 'Property management systems such as Opera, Mews, Cloudbeds and Guesty. Booking engines and OTAs including Booking.com, Expedia and Airbnb. Gmail, Outlook, WhatsApp Business and SMS providers. CRMs such as Salesforce, HubSpot and Zoho. Payment processors including Stripe, PayPal and Square. Channel managers such as SiteMinder, Channex and RoomRaccoon. If your system is not on that list, we build the connection.',
  },
  {
    q: 'Is AI automation secure for guest data?',
    a: 'Yes. Data is encrypted with AES-256 at rest and in transit. We comply with GDPR. API connections use OAuth 2.0 and encrypted endpoints. Access is role based, and we run regular security audits and penetration tests. We never share or sell guest data.',
  },
  {
    q: 'What is the ROI of hotel chatbots?',
    a: 'It comes from a few places: hours your front desk no longer spends on repeated questions, faster replies to enquiries, more direct bookings from guests who get an answer straight away, and fewer calls to reception. How much that adds up to depends on your size and how many enquiries you get. The calculator at /calculator gives an estimate from your own figures.',
    link: { href: '/calculator', label: 'Open the calculator' },
  },
  {
    q: 'How much does AI cost for a hotel?',
    a: 'It depends on which agents you need and how many systems we connect. A chatbot costs less than a full automation suite, and integration work is priced on the systems involved. We do not publish a price list because every property is different. Book a free call and we will give you a quote.',
  },
  {
    q: 'Can AI chatbots handle hotel bookings?',
    a: 'Yes, from start to finish. The agent checks live availability in your PMS, shows rates, packages and offers, collects the guest’s name, dates and requests, creates the booking in your system, sends the confirmation, and handles changes and cancellations. Because it is connected to your PMS and booking engine, what it quotes is accurate.',
  },
];

const seo = generateSEO({
  title: 'AI Automation FAQ for Tourism Businesses',
  description:
    'Answers to common questions about AI agents and chatbots for hotels and tourism businesses: setup time, cost, security, integrations and what the agents can do.',
  canonical: `${Astro.site}faq/`,
  ogType: 'website',
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'FAQ', url: `${Astro.site}faq/` },
  ]),
  generateFAQSchema(faqs.map((f) => ({ question: f.q, answer: f.a }))),
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="FAQ" compact>
    <Fragment slot="title">Questions owners <em>ask us first.</em></Fragment>
    <p slot="lead" class="v2-lead">
      What the agents do, how long setup takes, what it costs and how we look after guest data. If yours is not here,
      ask us.
    </p>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="questions">
    <div class="v2-container">
      <div class="v2-faq">
        <div class="v2-faq__left">
          <span class="v2-eyebrow" data-reveal>{faqs.length} questions</span>
          <h2 class="v2-h2" data-split>Plain answers, <em>no small print.</em></h2>
          <p class="v2-lead" data-reveal>
            Something else on your mind? <a href="/contact" class="v2-serif" style="color: var(--accent)">Ask us.</a>
          </p>
          <div data-reveal>
            <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
              <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </button>
          </div>
        </div>

        <div data-reveal>
          {
            faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <i aria-hidden="true" />
                </summary>
                <div class="v2-faq__a">
                  <p>{f.a}</p>
                  {f.link && (
                    <a class="v2-link faq-link" href={f.link.href}>
                      {f.link.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="start">
    <div class="v2-container">
      <div class="faq-cta">
        <span class="v2-eyebrow" data-reveal>Still wondering</span>
        <h2 class="v2-h2" data-split>Ask on a <em>thirty-minute call.</em></h2>
        <p class="v2-lead" data-reveal>
          Bring the job that takes up most of your week. We will tell you whether it is worth automating and what it
          would take.
        </p>
        <div class="faq-actions" data-reveal>
          <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
          <a class="v2-link" href="mailto:info@jengu.ai">or email us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .faq-link {
    margin-top: 16px;
  }
  .faq-cta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }
  .faq-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
</style>
