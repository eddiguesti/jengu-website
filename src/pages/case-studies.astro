---
/**
 * Case studies: Campasun, told as one long editorial case study. Built on
 * the v2 design system. Keeps the screenshot lightbox (#imageModal).
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'AI Automation Success Stories - Tourism Case Studies',
  description:
    'How Campasun reduced admin by 35% with AI-powered competitor tracking & dynamic pricing. Real results from hospitality businesses using AI automation. Read the full case study.',
  canonical: `${Astro.site}case-studies/`,
  ogType: 'website',
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Case Studies', url: `${Astro.site}case-studies/` },
  ]),
];

const ATTRIBUTION = 'As reported by Campasun';

const figures = [
  { value: '35%', label: 'Less admin work' },
  { value: '20%', label: 'More revenue' },
  { value: '25%', label: 'Higher guest satisfaction' },
];

const challenge = [
  {
    n: '01',
    title: 'Emails answered by hand',
    text: 'Staff read and replied to every email themselves. Replies were slow and uneven, and in peak season the team could not keep up.',
  },
  {
    n: '02',
    title: 'Prices set once and left',
    text: 'Fixed prices could not respond to competitor changes, the weather or local events, so revenue was left on the table.',
  },
  {
    n: '03',
    title: 'A different process at each site',
    text: 'Each of the eight campsites did things its own way, which made the group harder to run and harder to grow.',
  },
];

const built = [
  {
    n: '01',
    title: 'Process mapping',
    text: 'We mapped every business process across the campsites in Miro, found the slow spots and agreed one standard way of working.',
  },
  {
    n: '02',
    title: 'Email automation',
    text: 'A custom Python application, connected to the OpenAI API, that reads, sorts and answers customer emails around the clock.',
  },
  {
    n: '03',
    title: 'Operations automation',
    text: 'We automated the repetitive admin tasks and put the same workflows in place at all eight sites.',
  },
  {
    n: '04',
    title: 'A dynamic pricing engine',
    text: 'Pricing software built for campsites. It watches competitors, weather, local events and booking history, and suggests prices.',
  },
];

const engine = [
  {
    n: '01',
    title: 'Competitor tracking',
    text: 'The engine finds competitor campsites within a radius you set, using camping-and-co.com data, and tracks their prices and availability. For Campasun it follows more than ten competitors.',
  },
  {
    n: '02',
    title: 'Data enrichment',
    text: 'Booking history is enriched with weather (temperature, rainfall and sunshine hours), holiday calendars, school breaks and calendar features such as day of week and season.',
  },
  {
    n: '03',
    title: 'Price predictions',
    text: 'A machine learning model reads the booking history, capacity and market conditions and predicts prices 14 to 60 days ahead, against the occupancy target you set.',
  },
  {
    n: '04',
    title: 'Pricing strategies',
    text: 'Pick Conservative, Balanced or Aggressive, then tune demand sensitivity (30 to 90%), price aggression (40 to 100%) and the occupancy target (65 to 90%).',
  },
];

const screenshots = [
  { src: '/images/competitor-discovery.webp', alt: 'Competitor discovery screen', caption: 'Competitor discovery' },
  { src: '/images/data-enrichment.webp', alt: 'Data enrichment dashboard', caption: 'Data enrichment' },
  { src: '/images/pricing-strategy.webp', alt: 'Pricing strategy controls', caption: 'Pricing strategy controls' },
  { src: '/images/price-optimization.webp', alt: 'Price optimisation timeline', caption: 'Price optimisation timeline' },
  { src: '/images/forecasting.webp', alt: 'Revenue and occupancy forecasts', caption: 'Revenue and occupancy forecasts' },
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Case study" compact>
    <Fragment slot="title">Campasun: eight campsites, <em>one pricing engine.</em></Fragment>
    <p slot="lead" class="v2-lead">
      How a campsite operator in the South of France cut its admin, put one process in place across its
      sites and got a dynamic pricing tool built for campsites.
    </p>
    <dl slot="aside" class="meta">
      <dt>Client</dt>
      <dd>Campasun</dd>
      <dt>Sector</dt>
      <dd>Campsite hospitality</dd>
      <dt>Location</dt>
      <dd>South of France, 8 sites</dd>
    </dl>
  </V2PageHead>

  <section class="v2-section figures" data-theme="dark" id="results">
    <div class="v2-container">
      <div class="v2-case__figures" data-stagger>
        {
          figures.map((f) => (
            <div class="v2-case__figure" data-reveal>
              <b>{f.value}</b>
              <span>{f.label}</span>
              <small>{ATTRIBUTION}</small>
            </div>
          ))
        }
      </div>
      <p class="v2-body figures__note" data-reveal>
        These are the figures Campasun reported to us after the work. Results at another business will depend
        on what it does today.
      </p>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="challenge">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>The challenge</span>
          <h2 class="v2-h2" data-split>Eight sites, <em>too much typing.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Campasun runs eight campsites across the South of France. Three things were holding the group
            back.
          </p>
        </div>
      </div>
      <div class="v2-list" data-stagger>
        {
          challenge.map((r) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{r.n}</span>
              <h3 class="v2-list__title">{r.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{r.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="what-we-built">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>What we built</span>
          <h2 class="v2-h2" data-split>Map it, automate it, <em>then price it.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            We took the problems one at a time, starting with the processes and ending with the pricing.
          </p>
        </div>
      </div>
      <div class="v2-list" data-stagger>
        {
          built.map((r) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{r.n}</span>
              <h3 class="v2-list__title">{r.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{r.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="pricing-engine">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>The pricing engine</span>
          <h2 class="v2-h2" data-split>Built for campsites, <em>from scratch.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Pricing tools made for hotels did not fit how campsites work, so we built one. It is the
            biggest piece of the project.
          </p>
        </div>
      </div>
      <div class="v2-list" data-stagger>
        {
          engine.map((r) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{r.n}</span>
              <h3 class="v2-list__title">{r.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{r.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="platform">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>Inside the platform</span>
          <h2 class="v2-h2" data-split>Five screens <em>from the tool.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Competitor discovery, data enrichment, strategy controls, the price timeline and the forecasts.
            Click a screenshot to enlarge it.
          </p>
        </div>
      </div>
      <div class="v2-gallery" data-stagger>
        {
          screenshots.map((s) => (
            <figure data-reveal>
              <button type="button" class="shot" onclick={`openImageModal('${s.src}', '${s.alt}')`} aria-label={`Enlarge: ${s.caption}`}>
                <img src={s.src} alt={s.alt} loading="lazy" />
              </button>
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="quote">
    <div class="v2-container">
      <blockquote class="v2-quote" data-reveal>
        "Jengu built something that simply didn't exist in the campsite industry: an AI-powered pricing engine
        that actually understands our market. The system monitors competitors, overlays weather and holiday
        data, analyzes years of booking patterns, and uses machine learning to predict optimal prices. It's
        transformed how we manage pricing across our 8 locations. This level of intelligence was previously
        only available to hotels, and now we have it tailored specifically for campsites."
      </blockquote>
      <p class="v2-quote__by" data-reveal>Campasun management, South of France</p>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="cta">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>Your numbers</span>
          <h2 class="v2-h2" data-split>What would this look like <em>at your place?</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            The calculator gives you a rough estimate of the hours and money automation could save you. Or
            book a call and we will talk it through.
          </p>
          <div class="cta__actions" data-reveal>
            <a class="v2-btn v2-btn--accent" href="/calculator" data-magnetic>
              <span class="v2-btn__label"><span>Try the calculator</span><span>Try the calculator</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </a>
            <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
              <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshot lightbox -->
  <div class="lightbox" id="imageModal" onclick="closeImageModal()" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
    <button type="button" class="lightbox__close v2-link" onclick="closeImageModal()">Close <span aria-hidden="true">×</span></button>
    <img src="" alt="" id="modalImage" />
  </div>

  <script is:inline>
    function openImageModal(src, alt) {
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      if (!modal || !modalImg) return;
      modalImg.src = src;
      modalImg.alt = alt || 'Platform screenshot';
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeImageModal() {
      const modal = document.getElementById('imageModal');
      if (!modal) return;
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeImageModal();
    });
  </script>
</V2Layout>

<style>
  .meta {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 10px 16px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    font-size: 14.5px;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 2px;
  }
  .meta dd {
    margin: 0;
  }
  .figures {
    padding-top: 0;
  }
  .figures__note {
    margin-top: 20px;
    max-width: 60ch;
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shot img {
    display: block;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9500;
    display: none;
    place-items: center;
    padding: 72px var(--gutter) 40px;
    background: rgba(10, 10, 12, 0.94);
    cursor: zoom-out;
  }
  .lightbox.active {
    display: grid;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 112px);
    object-fit: contain;
  }
  .lightbox__close {
    position: absolute;
    top: 28px;
    right: var(--gutter);
    padding: 0;
    border: 0;
    background: none;
    color: #f4f3ef;
    cursor: pointer;
  }
</style>
