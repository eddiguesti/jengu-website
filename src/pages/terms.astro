---
/** Terms and conditions : page head plus legal prose on the v2 design system. */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'Terms & Conditions',
  description: 'Terms and conditions for using the Jengu Ltd website and services.',
  canonical: `${Astro.site}terms/`,
  ogType: 'website',
  noindex: false,
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Terms & Conditions', url: `${Astro.site}terms/` },
  ]),
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Legal" compact>
    <Fragment slot="title">Terms and <em>conditions.</em></Fragment>
    <p slot="lead" class="v2-lead">The terms that apply when you use www.jengu.ai or our services. Please read them before you do.</p>
    <p slot="aside" class="v2-prose__meta">Last updated: 2025</p>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="terms">
    <div class="v2-container">
      <div class="v2-prose v2-prose--legal" data-reveal>
        <h2>1. Introduction</h2>
        <p>
          These terms govern the use of www.jengu.ai and the services Jengu Ltd provides. By accessing the website you
          agree to comply with them.
        </p>

        <h2>2. Company information</h2>
        <ul>
          <li>Company name: Jengu Ltd</li>
          <li>Company number: 14157991</li>
          <li>Jurisdiction: United Kingdom</li>
        </ul>

        <h2>3. Use of the website</h2>
        <p>The site may be used for lawful purposes only. You agree not to:</p>
        <ul>
          <li>Engage in fraudulent, unlawful or harmful activity</li>
          <li>Attempt to gain unauthorised access to any system</li>
          <li>Use automated tools to extract data without permission</li>
          <li>Disrupt the security, performance or availability of the website</li>
        </ul>

        <h2>4. Services and content</h2>
        <p>
          Jengu Ltd provides process automation and AI-driven solutions for businesses. We try to keep the content on
          the site accurate but do not guarantee it. Services may be changed or withdrawn at any time without notice.
        </p>

        <h2>5. Intellectual property</h2>
        <p>
          All content on the website is owned by or licensed to Jengu Ltd. It may not be copied, modified, distributed
          or reproduced without written permission.
        </p>

        <h2>6. Information you send us</h2>
        <p>
          Contact information you submit must be accurate and lawful. We may use it to respond to your enquiry, and we
          store it securely in our CRM as described in the Privacy Policy.
        </p>

        <h2>7. Links to other sites</h2>
        <p>
          The site may link to third-party websites. Jengu Ltd is not responsible for their content, security or privacy
          practices.
        </p>

        <h2>8. Limitation of liability</h2>
        <p>
          Jengu Ltd disclaims liability for damages, errors, technical issues or data loss resulting from use of the
          website.
        </p>

        <h2>9. Indemnification</h2>
        <p>You agree to protect Jengu Ltd from claims arising from your breach of these terms or misuse of the website.</p>

        <h2>10. Changes to these terms</h2>
        <p>We may update these terms at any time. Continued use of the site means you accept the revised terms.</p>

        <h2>11. Governing law</h2>
        <p>
          These terms are governed by the law of the United Kingdom, and any dispute will be resolved in the courts of
          England and Wales.
        </p>

        <h2>12. Contact</h2>
        <p>
          For questions about these terms, email <a href="mailto:info@jengu.ai">info@jengu.ai</a>.
        </p>

        <p class="v2-prose__meta">Last updated: 2025</p>
      </div>
    </div>
  </section>
</V2Layout>
