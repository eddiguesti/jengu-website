---
/**
 * Services : what we build, how a project runs, what we look after and a
 * closing call to action. Built on the v2 design system (V2Layout, V2PageHead,
 * primitives in src/styles/v2/pages.css and sections.css).
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema, generateServiceSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'AI Automation Services for Tourism Businesses',
  description:
    'AI chat and phone agents, email handling, custom software and API integrations for tourism businesses. Guest support around the clock, dynamic pricing and PMS integration.',
  canonical: `${Astro.site}services/`,
  ogType: 'website',
});

const services = [
  {
    n: '01',
    title: 'Guest messaging agents',
    text: 'Chat on your website, WhatsApp and SMS, answered around the clock in 100+ languages. The agent takes bookings, answers questions and deals with support requests, and passes the conversation to a person when it should.',
    points: ['Website chat, WhatsApp and SMS', 'Replies in 100+ languages', 'Bookings, enquiries and support', 'Handover to your team when needed'],
  },
  {
    n: '02',
    title: 'Voice and booking agents',
    text: 'A voice agent that picks up the phone, quotes the right rate, takes the guest’s details and puts the booking into your PMS. It handles changes and cancellations too.',
    points: ['Answers every call', 'Quotes rates and takes bookings', 'Writes straight into your PMS', 'Changes and cancellations'],
  },
  {
    n: '03',
    title: 'Email handling',
    text: 'An agent that sorts your inbox, files each message, routes it to the right person and drafts replies in your tone of voice. It reads for tone as well, so an unhappy guest goes to the top of the pile.',
    points: ['Sorting and prioritising', 'Replies in your voice', 'Routing to the right person', 'Flags urgent messages', 'Works with your ticketing system'],
  },
  {
    n: '04',
    title: 'Integrations and automation',
    text: 'We connect the systems you already run so nobody retypes a reservation: PMS, CRM and booking engine, payments and accounting, channel managers and OTAs, email and messaging. Where an older system has no API, we write the middleware.',
    points: ['PMS, CRM and booking engine', 'Payments and accounting', 'Channel managers and OTAs', 'Email and messaging platforms', 'Middleware for legacy systems'],
  },
  {
    n: '05',
    title: 'Custom software',
    text: 'Applications built for how your business works: pricing engines, booking and reservation systems, tools for managing stock and resources, reporting dashboards, and mobile apps for staff and guests.',
    points: ['Dynamic pricing engines', 'Booking and reservation systems', 'Stock and resource tools', 'Dashboards and reporting', 'Apps for staff and guests'],
  },
  {
    n: '06',
    title: 'Process mapping',
    text: 'Before we automate anything we write down how the work gets done today. That shows where messages pile up, what gets retyped and which steps are worth automating. You get the map, an estimate of what each change is worth, and a plan for the order to do it in.',
    points: ['Workflow documentation', 'Finding the bottlenecks', 'What is worth automating', 'What each change is worth', 'A plan and an order of work'],
  },
];

const steps = [
  {
    n: '01',
    meta: 'You get a process map',
    title: 'Discovery',
    text: 'We sit with your team, map how the work gets done and find the jobs where automation would pay back first.',
  },
  {
    n: '02',
    meta: 'You get a plan',
    title: 'Design',
    text: 'We design the solution around your workflows and what you want out of it, and agree the scope with you.',
  },
  {
    n: '03',
    meta: 'You get a working system',
    title: 'Build',
    text: 'We build in short cycles with regular check-ins, so you see progress as it happens and can steer.',
  },
  {
    n: '04',
    meta: 'Ongoing',
    title: 'Launch and support',
    text: 'We roll it out, train your team and keep tuning the system after it goes live.',
  },
];

const care = [
  { title: 'GDPR', text: 'UK and EU data protection compliance on every project.' },
  { title: 'Encryption', text: 'AES-256 encryption for all data.' },
  { title: 'Training', text: 'Hands-on training for every level of staff, with written documentation and video tutorials made for your setup.' },
  { title: 'Support', text: 'A support team during business hours, regular reviews of how the system is doing, and updates as we add features.' },
];

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Services', url: `${Astro.site}services/` },
  ]),
  ...generateServiceSchema(services.map((s) => ({ name: s.title, description: s.text }))),
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Services">
    <Fragment slot="title">Six things we build <em>for hospitality.</em></Fragment>
    <p slot="lead" class="v2-lead">
      Guest messages, phone bookings, email, and the copy-paste between your systems. We build each one around how
      your property already runs.
    </p>
    <div slot="aside" class="svc-actions">
      <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
        <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
        <span class="v2-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
        </span>
      </button>
      <a class="v2-link" href="#build">What we build <span aria-hidden="true">→</span></a>
    </div>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="build">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>What we build</span>
          <h2 class="v2-h2" data-split>Agents, software and <em>the glue between them.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            For hotels, resorts, campsites, holiday parks, DMCs and tour operators. Every project starts with one job
            and grows from there.
          </p>
        </div>
      </div>

      <div class="v2-list">
        {
          services.map((s) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{s.n}</span>
              <h3 class="v2-list__title">{s.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{s.text}</p>
                <ul class="svc-points">
                  {s.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="process">
    <div class="v2-container">
      <div class="v2-process">
        <div class="v2-process__left">
          <span class="v2-eyebrow" data-reveal>How a project runs</span>
          <h2 class="v2-h2" data-split>Four steps, <em>in that order.</em></h2>
          <p class="v2-lead" data-reveal>
            We start small: one painful job, automated and measured, before you commit to anything bigger.
          </p>
          <div data-reveal>
            <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
              <span class="v2-btn__label"><span>Talk about a pilot</span><span>Talk about a pilot</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </button>
          </div>
        </div>

        <div>
          {
            steps.map((s) => (
              <div class="v2-pstep" data-reveal>
                <span class="v2-pstep__n">{s.n}</span>
                <div>
                  <span class="v2-pstep__meta">{s.meta}</span>
                  <h3>{s.title}</h3>
                  <p class="v2-body">{s.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="care">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>What we look after</span>
          <h2 class="v2-h2" data-split>Your data, your team, <em>and the system after launch.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Guest data is handled under UK and EU rules and encrypted throughout. Your staff are trained on what we
            build, and we stay around after it goes live.
          </p>
        </div>
      </div>

      <div class="v2-pillars" data-stagger>
        {
          care.map((c, i) => (
            <div class="v2-pillar" data-reveal>
              <span class="v2-pillar__n">0{i + 1}</span>
              <div>
                <h3>{c.title}</h3>
                <p class="v2-body">{c.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="start">
    <div class="v2-container">
      <div class="svc-cta">
        <span class="v2-eyebrow" data-reveal>Next step</span>
        <h2 class="v2-h2" data-split>Start with <em>one workflow.</em></h2>
        <p class="v2-lead" data-reveal>
          Tell us which job eats the most of your week. We will map it, quote it and tell you plainly whether it is
          worth automating. If you want a rough figure first, the calculator works from your own numbers.
        </p>
        <div class="svc-actions" data-reveal>
          <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
          <a class="v2-link" href="/calculator">Estimate your savings <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .svc-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .svc-points {
    display: flex;
    flex-direction: column;
  }
  .svc-points li {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .svc-points li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .svc-cta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }
</style>
