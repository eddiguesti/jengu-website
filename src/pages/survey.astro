---
/**
 * Survey: why we ask on the left, the form on the right. Field names, option
 * values and required flags match what /api/survey expects; do not rename them.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'AI in Travel & Hospitality Survey',
  description: 'Help us understand AI adoption and automation priorities in travel and hospitality. This survey takes 4-6 minutes to complete.',
  canonical: `${Astro.site}survey/`,
  ogType: 'website'
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Survey', url: `${Astro.site}survey/` }
  ])
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Survey" compact>
    <Fragment slot="title">AI in travel and <em>hospitality.</em></Fragment>
    <p slot="lead" class="v2-lead">
      A short survey on how travel and hospitality companies are approaching AI and automation. It takes 4 to 6 minutes.
    </p>
  </V2PageHead>

  <section class="v2-section" data-theme="dark">
    <div class="v2-container">
      <div class="v2-split">
        <div class="v2-split__left">
          <h2 class="v2-h3" data-split>Why we ask</h2>
          <p class="v2-body" data-reveal>
            We are researching how companies in travel and hospitality are approaching AI and automation. Your answers show us which priorities and problems are real for teams like yours.
          </p>
          <p class="v2-body" data-reveal>
            There are five short sections. Fields marked with an asterisk are required. Most people finish in 4 to 6 minutes.
          </p>
          <a href="/book/" class="v2-link" data-reveal>Prefer a conversation? Book a call <span aria-hidden="true">→</span></a>
        </div>

        <form id="fairSurveyForm" class="v2-form" onsubmit="submitSurvey(event)" data-reveal>
          <div class="v2-form__group">
            <h3 class="v2-form__group-title">About you</h3>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="contactName">Your name *</label>
                <input type="text" id="contactName" name="contactName" required />
              </div>
              <div class="v2-field">
                <label for="role">Job title</label>
                <input type="text" id="role" name="role" placeholder="General manager, head of operations, revenue lead" />
              </div>
            </div>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="company">Company *</label>
                <input type="text" id="company" name="company" required />
              </div>
              <div class="v2-field">
                <label for="country">Country or region</label>
                <input type="text" id="country" name="country" placeholder="United Kingdom, Spain, Europe" />
              </div>
            </div>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="email">Work email *</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="v2-field">
                <label for="phone">Phone or WhatsApp</label>
                <input type="tel" id="phone" name="phone" />
              </div>
            </div>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="businessModel">Business type *</label>
                <select id="businessModel" name="businessModel" required>
                  <option value="">Choose one</option>
                  <option value="hotel">Hotel</option>
                  <option value="hotel-group">Hotel group</option>
                  <option value="resort">Resort</option>
                  <option value="vacation-rentals">Holiday rentals</option>
                  <option value="travel-agency">Travel agency</option>
                  <option value="tour-operator">Tour operator</option>
                  <option value="destination-management">Destination management company</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="v2-field">
                <label for="companySize">Company size *</label>
                <select id="companySize" name="companySize" required>
                  <option value="">Choose one</option>
                  <option value="1-10">1 to 10 employees</option>
                  <option value="11-50">11 to 50 employees</option>
                  <option value="51-200">51 to 200 employees</option>
                  <option value="201-500">201 to 500 employees</option>
                  <option value="500-plus">500+ employees</option>
                </select>
              </div>
            </div>
          </div>

          <div class="v2-form__group">
            <h3 class="v2-form__group-title">Your current situation</h3>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="monthlyBookingVolume">Monthly bookings or leads *</label>
                <select id="monthlyBookingVolume" name="monthlyBookingVolume" required>
                  <option value="">Choose one</option>
                  <option value="under-500">Under 500</option>
                  <option value="500-2000">500 to 2,000</option>
                  <option value="2000-10000">2,000 to 10,000</option>
                  <option value="10000-plus">10,000+</option>
                  <option value="unknown">Not sure</option>
                </select>
              </div>
              <div class="v2-field">
                <label for="stakeholderCount">People involved in this decision *</label>
                <select id="stakeholderCount" name="stakeholderCount" required>
                  <option value="">Choose one</option>
                  <option value="1-2">1 to 2 people</option>
                  <option value="3-5">3 to 5 people</option>
                  <option value="6-10">6 to 10 people</option>
                  <option value="10-plus">10+ people</option>
                </select>
              </div>
            </div>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="currentResponseTime">Current average response time *</label>
                <select id="currentResponseTime" name="currentResponseTime" required>
                  <option value="">Choose one</option>
                  <option value="under-5-min">Under 5 minutes</option>
                  <option value="5-30-min">5 to 30 minutes</option>
                  <option value="30-min-2-hours">30 minutes to 2 hours</option>
                  <option value="2-24-hours">2 to 24 hours</option>
                  <option value="over-24-hours">Over 24 hours</option>
                </select>
              </div>
              <div class="v2-field">
                <label for="decisionOwner">Who leads this area in your organisation?</label>
                <input type="text" id="decisionOwner" name="decisionOwner" placeholder="A role is enough: GM, COO, head of operations" />
              </div>
            </div>

            <div class="v2-form__row">
              <div class="v2-field">
                <label for="channelPreference">Preferred contact method *</label>
                <select id="channelPreference" name="channelPreference" required>
                  <option value="">Choose one</option>
                  <option value="video-call">Video call</option>
                  <option value="in-person">In person</option>
                  <option value="email-summary-first">Email summary first</option>
                  <option value="whatsapp-first">WhatsApp first</option>
                </select>
              </div>
              <div class="v2-field">
                <label for="alignmentRisk">How aligned is your team on this? *</label>
                <select id="alignmentRisk" name="alignmentRisk" required>
                  <option value="">Choose one</option>
                  <option value="highly-aligned">Highly aligned</option>
                  <option value="mostly-aligned">Mostly aligned</option>
                  <option value="mixed-priorities">Mixed priorities</option>
                  <option value="not-aligned-yet">Not aligned yet</option>
                </select>
              </div>
            </div>

            <div class="v2-field">
              <label for="currentSetup">Your current setup in one sentence *</label>
              <textarea id="currentSetup" name="currentSetup" required placeholder="How your team handles enquiries, bookings, pricing and guest messages today."></textarea>
            </div>

            <div class="v2-field">
              <span class="v2-field__label">Top challenges right now * (choose up to 3)</span>
              <div class="v2-checks">
                <label class="v2-check"><input type="checkbox" name="painPoints" value="slow-reply-times" /> <span>Slow replies to guests</span></label>
                <label class="v2-check"><input type="checkbox" name="painPoints" value="low-direct-bookings" /> <span>Low direct bookings</span></label>
                <label class="v2-check"><input type="checkbox" name="painPoints" value="high-manual-work" /> <span>Too much manual admin</span></label>
                <label class="v2-check"><input type="checkbox" name="painPoints" value="fragmented-systems" /> <span>Systems that do not talk to each other</span></label>
                <label class="v2-check"><input type="checkbox" name="painPoints" value="pricing-uncertainty" /> <span>Pricing and forecasting</span></label>
                <label class="v2-check"><input type="checkbox" name="painPoints" value="staff-shortage" /> <span>Staffing constraints</span></label>
              </div>
            </div>
          </div>

          <div class="v2-form__group">
            <h3 class="v2-form__group-title">What is getting in the way</h3>

            <div class="v2-field">
              <label for="problemDetail">What is your biggest operational constraint today? *</label>
              <textarea id="problemDetail" name="problemDetail" required placeholder="The process or workflow that most needs to improve."></textarea>
            </div>

            <div class="v2-field">
              <span class="v2-field__label">AI and automation areas of interest * (choose all that apply)</span>
              <div class="v2-checks">
                <label class="v2-check"><input type="checkbox" name="priorities" value="ai-chatbot" /> <span>AI chatbot for website or WhatsApp</span></label>
                <label class="v2-check"><input type="checkbox" name="priorities" value="voice-bot" /> <span>AI phone or voice bot</span></label>
                <label class="v2-check"><input type="checkbox" name="priorities" value="dynamic-pricing" /> <span>Dynamic pricing and demand forecasting</span></label>
                <label class="v2-check"><input type="checkbox" name="priorities" value="crm-automation" /> <span>CRM and email automation</span></label>
                <label class="v2-check"><input type="checkbox" name="priorities" value="pms-integration" /> <span>PMS or channel manager integrations</span></label>
                <label class="v2-check"><input type="checkbox" name="priorities" value="custom-software" /> <span>Custom AI software</span></label>
              </div>
            </div>
          </div>

          <div class="v2-form__group">
            <h3 class="v2-form__group-title">What is at stake</h3>

            <div class="v2-field">
              <label for="implicationDetail">What happens if this is not solved in the next 6 to 12 months? *</label>
              <textarea id="implicationDetail" name="implicationDetail" required placeholder="For example: lost direct bookings, slower growth, higher staffing cost, a weaker guest experience."></textarea>
            </div>

            <div class="v2-field">
              <label for="currentTools">Current systems and tools</label>
              <input type="text" id="currentTools" name="currentTools" placeholder="PMS, CRM, booking engine, channel manager, call centre tools" />
            </div>

            <div class="v2-field">
              <label for="goals">What outcomes matter most to you? *</label>
              <textarea id="goals" name="goals" required placeholder="For example: more direct bookings, replies in under two minutes, fewer repetitive tasks."></textarea>
            </div>
          </div>

          <div class="v2-form__group">
            <h3 class="v2-form__group-title">What good looks like</h3>

            <div class="v2-field">
              <label for="successDefinition">What would a meaningful improvement look like for your business? *</label>
              <textarea id="successDefinition" name="successDefinition" required placeholder="The specific outcomes your team would notice."></textarea>
            </div>

            <div class="v2-field">
              <label for="decisionCriteria">Anything else we should know? *</label>
              <textarea id="decisionCriteria" name="decisionCriteria" required placeholder="Any other detail about your priorities or situation."></textarea>
            </div>

            <label class="v2-check">
              <input type="checkbox" id="consent" name="consent" required />
              <span>I am happy to share this survey response with Jengu. *</span>
            </label>
          </div>

          <button type="submit" class="v2-btn v2-btn--accent" id="surveySubmitBtn" data-magnetic>
            <span class="v2-btn__label"><span>Send my answers</span><span>Send my answers</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>

          <p class="v2-form__note">We only use your answers for this research and to follow up if you ask us to.</p>
          <div id="surveyStatus" class="v2-form__status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const SURVEY_ENDPOINT = '/api/survey';
    const MAX_PAIN_POINTS = 3;

    function setStatus(status, kind, text) {
      status.className = kind ? `v2-form__status ${kind}` : 'v2-form__status';
      status.textContent = text;
    }

    function setButtonLabel(button, text) {
      button.querySelectorAll('.v2-btn__label span').forEach((span) => {
        span.textContent = text;
      });
    }

    function checkedValues(form, name) {
      return Array.from(form.querySelectorAll(`input[name="${name}"]:checked`)).map((item) => item.value);
    }

    async function submitSurvey(event) {
      event.preventDefault();

      const form = event.target;
      const submitButton = document.getElementById('surveySubmitBtn');
      const status = document.getElementById('surveyStatus');
      const originalLabel = submitButton.querySelector('.v2-btn__label span').textContent;

      setStatus(status, '', '');

      const painPoints = checkedValues(form, 'painPoints');
      const priorities = checkedValues(form, 'priorities');

      if (painPoints.length === 0 || painPoints.length > MAX_PAIN_POINTS) {
        setStatus(status, 'is-error', 'Please choose between 1 and 3 challenges.');
        return;
      }

      if (priorities.length === 0) {
        setStatus(status, 'is-error', 'Please choose at least one area of interest.');
        return;
      }

      const payload = {
        contactName: form.contactName.value,
        role: form.role.value,
        company: form.company.value,
        country: form.country.value,
        email: form.email.value,
        phone: form.phone.value,
        businessModel: form.businessModel.value,
        companySize: form.companySize.value,
        monthlyBookingVolume: form.monthlyBookingVolume.value,
        stakeholderCount: form.stakeholderCount.value,
        currentResponseTime: form.currentResponseTime.value,
        decisionOwner: form.decisionOwner.value,
        channelPreference: form.channelPreference.value,
        alignmentRisk: form.alignmentRisk.value,
        currentSetup: form.currentSetup.value,
        painPoints,
        problemDetail: form.problemDetail.value,
        priorities,
        implicationDetail: form.implicationDetail.value,
        currentTools: form.currentTools.value,
        goals: form.goals.value,
        successDefinition: form.successDefinition.value,
        decisionCriteria: form.decisionCriteria.value,
        consent: form.consent.checked
      };

      submitButton.disabled = true;
      setButtonLabel(submitButton, 'Sending');

      try {
        const response = await fetch(SURVEY_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || 'The survey could not be sent.');
        }

        form.reset();
        setStatus(status, 'is-ok', result.message || 'Thank you. Your answers have been recorded.');
      } catch (error) {
        setStatus(status, 'is-error', error.message || 'Something went wrong. Please try again.');
      } finally {
        submitButton.disabled = false;
        setButtonLabel(submitButton, originalLabel);
      }
    }

    window.submitSurvey = submitSurvey;
  </script>
</V2Layout>

<style>
  .v2-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>
