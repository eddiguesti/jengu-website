---
/**
 * /book: the booking widget is the BookingModal that V2Layout already renders
 * on every page (one set of ids per page), so this page opens it on load and
 * keeps a button on the page for anyone who closes it.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { getTranslations } from '../i18n';

const t = getTranslations('en');

const seo = generateSEO({
  // generateSEO appends " | Jengu" itself.
  title: 'Book a Free Consultation',
  description: 'Schedule a free 30-minute consultation with our AI automation experts. Discover how Jengu can transform your hospitality operations.',
  canonical: '/book',
  ogType: 'website'
});
---

<V2Layout seo={seo}>
  <V2PageHead eyebrow="Book a call" compact>
    <Fragment slot="title">{t.booking.title}</Fragment>
    <p slot="lead" class="v2-lead">{t.booking.subtitle}</p>
  </V2PageHead>

  <section class="v2-section" data-theme="dark">
    <div class="v2-container">
      <div class="v2-split">
        <div class="v2-split__left">
          <span class="v2-mono book__duration" data-reveal>{t.booking.duration}</span>
          <h2 class="v2-h3" data-split>How it works</h2>
        </div>

        <div class="book__body" data-reveal>
          <p class="v2-body">
            The booking form opens on its own when this page loads. Choose a day and a time, add your name and email, and pick how you would like to take the call. We create the calendar event from there.
          </p>
          <p class="v2-body">
            If the form has not appeared, or you closed it, open it again here.
          </p>
          <button class="v2-btn v2-btn--accent" type="button" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Open the booking form</span><span>Open the booking form</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
          <a href="mailto:info@jengu.ai" class="v2-link">or email us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tells /scripts/booking-modal-deferred.js (loaded by the layout's BookingModal) to initialise straight away. -->
  <script is:inline>
    window.isBookingPage = true;
  </script>

  <!-- Open the layout's booking modal once everything has loaded. -->
  <script is:inline>
    window.addEventListener('load', () => setTimeout(() => window.openBookingModal?.(), 400));
  </script>
</V2Layout>

<style>
  .book__duration {
    color: var(--muted);
  }
  .book__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 60ch;
  }
  .book__body .v2-btn {
    margin-top: 8px;
  }
</style>
