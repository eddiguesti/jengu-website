---
/**
 * 404: not found. Built on the v2 design system.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import { generateSEO } from '../lib/seo/metadata';

const seo = generateSEO({
  title: 'Page Not Found',
  description:
    'The page you are looking for could not be found. Return to the Jengu homepage to explore our AI automation solutions for tourism and hospitality.',
  noindex: true,
});
---

<V2Layout seo={seo}>
  <section class="v2-404" data-theme="dark">
    <div class="inner">
      <span class="v2-eyebrow" data-reveal>Not found</span>
      <h1 class="v2-h1" data-split>404</h1>
      <p class="v2-lead" data-reveal>That page is not here. It may have moved, or the link was wrong.</p>
      <div class="actions" data-reveal>
        <a class="v2-link" href="/">Go to the home page <span aria-hidden="true">→</span></a>
        <a class="v2-link" href="/contact">Contact us <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</V2Layout>

<style>
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .inner .v2-lead {
    text-align: center;
    margin: 0 auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    margin-top: 8px;
  }
</style>
