---
/**
 * Blog post: a light reading page with a sticky rail (dates, author, read
 * time), the rendered post in .v2-prose, and related posts on a dark section.
 */
import { getCollection } from 'astro:content';
import V2Layout from '../../components/v2/V2Layout.astro';
import { generateSEO } from '../../lib/seo/metadata';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return data.draft !== true && data.archived !== true;
  });

  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const seo = generateSEO({
  // generateSEO already appends " | Jengu", so the title stays unbranded here.
  title: entry.data.title,
  description: entry.data.description,
  canonical: `${Astro.site}blog/${entry.slug}/`,
  ogType: 'article',
  ogImage: entry.data.mainImage || entry.data.thumbnail,
  publishedTime: entry.data.publishedOn.toISOString(),
  modifiedTime: entry.data.updatedOn?.toISOString() || entry.data.publishedOn.toISOString(),
  author: entry.data.author || 'Jengu Team',
  section: 'Technology'
});

const jsonLd = [
  generateArticleSchema({
    type: 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedOn.toISOString(),
    updatedAt: entry.data.updatedOn?.toISOString() || entry.data.publishedOn.toISOString(),
    image: entry.data.mainImage || entry.data.thumbnail || '',
    authorName: entry.data.author || 'Jengu Team',
    url: `${Astro.site}blog/${entry.slug}/`
  }),
  generateBreadcrumbSchema([
    { name: 'Home', url: `${Astro.site}` },
    { name: 'Blog', url: `${Astro.site}blog/` },
    { name: entry.data.title, url: `${Astro.site}blog/${entry.slug}/` }
  ])
];

const DATE_FORMAT: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
const SHORT_DATE_FORMAT: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' };
const WORDS_PER_MINUTE = 220;

const formattedDate = entry.data.publishedOn.toLocaleDateString('en-GB', DATE_FORMAT);
const updatedOn = entry.data.updatedOn;
const wasUpdated = Boolean(updatedOn && updatedOn.getTime() !== entry.data.publishedOn.getTime());
const updatedDate = wasUpdated && updatedOn ? updatedOn.toLocaleDateString('en-GB', DATE_FORMAT) : null;
const author = entry.data.author || 'Jengu Team';
const readTime = Math.max(1, Math.round(entry.body.trim().split(/\s+/).length / WORDS_PER_MINUTE));

// Related posts: score other posts by shared slug keywords so every article
// links out to 3 relevant ones. This builds an internal link graph that helps
// Google discover and index the deeper posts (fixes "Discovered, not indexed").
const STOP_WORDS = new Set([
  'the', 'for', 'and', 'with', 'your', 'how', 'ai', 'to', 'in', 'of', 'a',
  'guide', 'best', 'top', '2024', '2025', '2026', 'business', 'businesses'
]);
const tokensOf = (slug: string) =>
  new Set(slug.split('-').filter((t) => t.length > 2 && !STOP_WORDS.has(t)));
const currentTokens = tokensOf(entry.slug);

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true && data.archived !== true);
const relatedPosts = allPosts
  .filter((p) => p.slug !== entry.slug)
  .map((p) => {
    const t = tokensOf(p.slug);
    let score = 0;
    for (const tok of currentTokens) if (t.has(tok)) score += 1;
    return { post: p, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.publishedOn.getTime() - a.post.data.publishedOn.getTime())
  .slice(0, 3)
  .map(({ post }) => ({
    title: post.data.title,
    url: `/blog/${post.slug}/`,
    image: post.data.thumbnail || post.data.mainImage || '',
    dateIso: post.data.publishedOn.toISOString().split('T')[0],
    dateLabel: post.data.publishedOn.toLocaleDateString('en-GB', SHORT_DATE_FORMAT)
  }));
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <article class="v2-article" data-theme="light">
    <div class="v2-container">
      <header class="v2-article__head">
        <a href="/blog/" class="v2-eyebrow" data-reveal>Journal</a>
        <h1 class="v2-h1" data-split>{entry.data.title}</h1>
        {entry.data.subtitle && (
          <p class="v2-article__sub" data-reveal>{entry.data.subtitle}</p>
        )}
      </header>

      {entry.data.mainImage && (
        <figure class="post-hero" data-reveal>
          <img
            class="v2-article__hero"
            src={entry.data.mainImage}
            alt={entry.data.altText || ''}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {entry.data.altText && <figcaption class="v2-mono">{entry.data.altText}</figcaption>}
        </figure>
      )}

      <div class="v2-article__grid">
        <aside class="v2-article__rail" data-reveal>
          <div class="rail__item">
            <span class="rail__key">Published</span>
            <time class="v2-mono" datetime={entry.data.publishedOn.toISOString()}>{formattedDate}</time>
          </div>
          {updatedDate && (
            <div class="rail__item">
              <span class="rail__key">Updated</span>
              <time class="v2-mono" datetime={updatedOn?.toISOString()}>{updatedDate}</time>
            </div>
          )}
          <div class="rail__item">
            <span class="rail__key">Written by</span>
            <span class="v2-mono">{author}</span>
          </div>
          <div class="rail__item">
            <span class="rail__key">Reading time</span>
            <span class="v2-mono">{readTime} min</span>
          </div>
          <a href="/blog/" class="v2-link">All posts <span aria-hidden="true">→</span></a>
        </aside>

        <div class="v2-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="v2-section" data-theme="dark" aria-labelledby="related-title">
      <div class="v2-container">
        <aside class="v2-related">
          <span class="v2-eyebrow" data-reveal>Keep reading</span>
          <h2 id="related-title" class="v2-h3 related__title" data-split>More from the journal.</h2>
          <div class="v2-posts">
            {relatedPosts.map((rp) => (
              <a href={rp.url} class="v2-post" data-reveal>
                <span class="v2-post__date"><time datetime={rp.dateIso}>{rp.dateLabel}</time></span>
                <h3 class="v2-post__title">{rp.title}</h3>
                {rp.image ? (
                  <img class="v2-post__thumb" src={rp.image} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="v2-post__thumb" aria-hidden="true"></span>
                )}
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>
  )}
</V2Layout>

<style>
  .post-hero {
    margin: 0 0 clamp(40px, 5vw, 72px);
  }
  .post-hero .v2-article__hero {
    margin: 0;
  }
  .post-hero figcaption {
    margin-top: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .rail__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rail__key {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  /* Related posts sit in their own section here, so the in-article divider is not needed. */
  .v2-related {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .related__title {
    margin: 20px 0 clamp(32px, 4vw, 56px);
  }
  span.v2-post__thumb {
    display: block;
  }
</style>
