---
/**
 * About: who Jengu is, how we work, and who does the work. Built on the v2
 * design system: V2Layout, V2PageHead and the inner-page primitives in
 * styles/v2/pages.css.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'About Jengu | The People Behind Your AI Advantage',
  description:
    'We are a new company with a long history. Our team of seasoned AI and automation experts is dedicated to building practical, results-driven AI solutions for the tourism and hospitality industry.',
  canonical: `${Astro.site}about/`,
  ogType: 'article',
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'About', url: `${Astro.site}about/` },
  ]),
];

const steps = [
  {
    n: '01',
    title: 'Discover and analyse',
    text: 'We sit with your team and look at how the work gets done today: which jobs eat the hours and where messages pile up.',
  },
  {
    n: '02',
    title: 'Map and strategise',
    text: 'We write the process down properly, agree which part to automate first and decide what a good result looks like.',
  },
  {
    n: '03',
    title: 'Build and integrate',
    text: 'We build the software and connect it to the systems you already use.',
  },
  {
    n: '04',
    title: 'Optimise and support',
    text: 'After launch we watch how it performs, fix what needs fixing and keep improving it with you.',
  },
];

const principles = [
  {
    n: '01',
    title: 'Pragmatic partnership',
    text: 'We work alongside your team on the problems you have now, with tools that fit the job. We are not interested in selling you whatever is fashionable this year.',
  },
  {
    n: '02',
    title: 'Honest engineering',
    text: 'We build systems that hold up, and we are open about how they work, from the code to our emails. We tell you what you need to hear, even when it is not what you hoped for.',
  },
  {
    n: '03',
    title: 'Measurable impact',
    text: 'We judge our work by what it does for you: the hours your team gets back and the revenue you gain.',
  },
];

const people = [
  {
    name: 'Danny Smith',
    role: 'Director',
    initials: 'DS',
    photo: '/images/team/danny-smith.webp',
    bio: 'Danny designs remote organisations that run well. He helped scale Oyster from 14 to 500 people and a $1bn valuation, and has worked as a software engineer and as COO for several tech companies.',
    linkedin: 'https://www.linkedin.com/in/dannyasmith/',
  },
  {
    name: 'Edward Guest',
    role: 'Chief Innovation Officer',
    initials: 'EG',
    bio: 'Edward leads AI strategy at Jengu and builds the automation behind the products.',
    linkedin: 'https://www.linkedin.com/in/edwardguest1/',
  },
  {
    name: 'Christopher Guest',
    role: 'Senior Process Automation Engineer',
    initials: 'CG',
    bio: 'Christopher maps business processes and designs and builds the automation workflows that replace the manual ones.',
    linkedin: 'https://www.linkedin.com/in/christopher-guest-04149551/',
  },
  {
    name: 'Lisa Mitte',
    role: 'Lead Business Process Analyst',
    initials: 'LM',
    bio: 'Lisa analyses how a business runs and finds the places where automation pays for itself.',
    linkedin: 'https://www.linkedin.com/in/lisa-mit-73ba25234/',
  },
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="About">
    <Fragment slot="title">A new company with a <em>long history.</em></Fragment>
    <p slot="lead" class="v2-lead">
      Jengu was founded in 2023, but the people behind it had been working on this for years. We are AI
      engineers, automation specialists and hospitality insiders who saw a gap between what AI could do and
      what tourism businesses needed, and we set up Jengu to close it.
    </p>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="story">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>The story</span>
          <h2 class="v2-h2" data-split>Founded in 2023. <em>People first.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            We build practical AI for tourism and hospitality businesses. The aim is simple: save your team
            time, bring in more revenue and give guests a better stay.
          </p>
        </div>
      </div>
      <div class="v2-prose" data-reveal>
        <p>
          Most of what we do starts with a conversation about how a business runs day to day. The technology
          comes second. When it does come, it has to fit the way your people already work, and it has to
          produce a result you can see in the numbers.
        </p>
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="how-we-work">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>How we work</span>
          <h2 class="v2-h2" data-split>Four steps, <em>in order.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            The same sequence on every project, whether it is one workflow or a full set of agents.
          </p>
        </div>
      </div>
      <div class="v2-list" data-stagger>
        {
          steps.map((s) => (
            <div class="v2-list__row v2-list__row--2" data-reveal>
              <span class="v2-list__n">{s.n}</span>
              <div class="v2-list__body">
                <h3 class="v2-list__title">{s.title}</h3>
                <p class="v2-body">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="principles">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>Principles</span>
          <h2 class="v2-h2" data-split>What we hold <em>ourselves to.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Three rules that shape how we write code and how we talk to you.
          </p>
        </div>
      </div>
      <div class="v2-list" data-stagger>
        {
          principles.map((p) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{p.n}</span>
              <h3 class="v2-list__title">{p.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{p.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="people">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>The people</span>
          <h2 class="v2-h2" data-split>A small team that <em>builds and stays.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Four people, and all of them work on the projects directly.
          </p>
          <div data-reveal>
            <a class="v2-link" href="/team">Meet the team <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="v2-people" data-stagger>
        {
          people.map((m) => (
            <div class="v2-person" data-reveal>
              {m.photo ? (
                <img class="v2-person__photo" src={m.photo} alt={m.name} width="96" height="96" loading="lazy" />
              ) : (
                <span class="v2-person__photo" aria-hidden="true">{m.initials}</span>
              )}
              <div>
                <h3>{m.name}</h3>
                <span class="v2-person__role">{m.role}</span>
                <p class="v2-body">{m.bio}</p>
                <div class="v2-person__links">
                  <a class="v2-link" href={m.linkedin} target="_blank" rel="noopener noreferrer">
                    LinkedIn <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="cta">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>Next step</span>
          <h2 class="v2-h2" data-split>Talk to us about <em>one workflow.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            A free call with one of the team. Bring the job that costs you the most hours and we will tell you
            what we would do with it.
          </p>
          <div data-reveal>
            <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
              <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</V2Layout>
