---
/**
 * /book/chris-wood: private booking link for Chris. The booking widget is the
 * BookingModal that V2Layout already renders (one set of ids per page), so this
 * page opens it on load and keeps a button on the page for anyone who closes it.
 */
import V2Layout from '../../components/v2/V2Layout.astro';
import V2PageHead from '../../components/v2/V2PageHead.astro';
import { generateSEO } from '../../lib/seo/metadata';
import { getTranslations } from '../../i18n';

const t = getTranslations('en');

const teamMember = {
  name: 'Chris Wood',
  role: 'AI Solutions Architect',
  email: 'chris@jengu.ai'
};

const initials = teamMember.name
  .split(' ')
  .map((part) => part.charAt(0))
  .join('');

const seo = generateSEO({
  // generateSEO appends " | Jengu" itself.
  title: `Book with ${teamMember.name}`,
  description: 'Schedule a consultation with Chris Wood, AI Solutions Architect at Jengu. Discover how AI can transform your hospitality operations.',
  canonical: '/book/chris-wood',
  ogType: 'website',
  // Private page: keep it out of search results.
  noindex: true,
  nofollow: true
});
---

<V2Layout seo={seo}>
  <V2PageHead eyebrow="Book a call" compact>
    <Fragment slot="title">Book a call with <em>{teamMember.name}.</em></Fragment>
    <p slot="lead" class="v2-lead">{t.booking.subtitle}</p>
  </V2PageHead>

  <section class="v2-section" data-theme="dark">
    <div class="v2-container">
      <div class="v2-split">
        <div class="v2-split__left">
          <span class="v2-person__photo" aria-hidden="true" data-reveal>{initials}</span>
          <div data-reveal>
            <h2 class="v2-h3">{teamMember.name}</h2>
            <span class="v2-person__role">{teamMember.role}</span>
            <span class="v2-mono host__duration">{t.booking.duration}</span>
          </div>
          <a href={`mailto:${teamMember.email}`} class="v2-link" data-reveal>{teamMember.email} <span aria-hidden="true">→</span></a>
        </div>

        <div class="host__body" data-reveal>
          <p class="v2-body">
            The booking form opens on its own when this page loads. Choose a day and a time, add your name and email, and pick how you would like to take the call. The meeting is with {teamMember.name}.
          </p>
          <p class="v2-body">
            If the form has not appeared, or you closed it, open it again here.
          </p>
          <button class="v2-btn v2-btn--accent" type="button" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Open the booking form</span><span>Open the booking form</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Tells /scripts/booking-modal-deferred.js (loaded by the layout's BookingModal) to initialise straight away, and names the host. -->
  <script is:inline>
    window.isBookingPage = true;
    window.bookingHost = 'Chris Wood';
  </script>

  <!-- Open the layout's booking modal once everything has loaded. -->
  <script is:inline>
    window.addEventListener('load', () => setTimeout(() => window.openBookingModal?.(), 400));
  </script>
</V2Layout>

<style>
  .host__duration {
    display: block;
    color: var(--muted);
  }
  .host__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 60ch;
  }
  .host__body .v2-btn {
    margin-top: 8px;
  }
</style>
