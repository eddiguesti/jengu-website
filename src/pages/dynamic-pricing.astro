---
/**
 * Dynamic pricing : the problem with flat rates, how the pricing engine works
 * (with screenshots), what moves prices, the commercial model and a call to
 * action. Built on the v2 design system.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema, generateSoftwareApplicationSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'Dynamic Pricing Software for Campsites and Holiday Parks',
  description:
    'Dynamic pricing for campsites and holiday parks. Rates that move with demand, the season, the weather and what nearby sites charge. Nothing upfront: you pay 15% of the extra profit.',
  canonical: `${Astro.site}dynamic-pricing/`,
  ogType: 'website',
});

const problems = [
  {
    n: '01',
    title: 'Peak weekends priced like a Tuesday',
    text: 'Bank holidays and sunny weekends could carry a higher rate. A flat rate card charges the same on every day, so the busy dates earn less than they should.',
  },
  {
    n: '02',
    title: 'Empty pitches in the quiet weeks',
    text: 'A lower price would fill some of them. Changing rates by hand takes time, though, and you are never sure whether you have set them right.',
  },
  {
    n: '03',
    title: 'Signals nobody has time to watch',
    text: 'Local events, the weather forecast and what nearby sites charge all change from day to day. A static rate ignores every one of them.',
  },
  {
    n: '04',
    title: 'Hours spent updating rates',
    text: 'Every change has to be typed into each booking platform. That is time spent on spreadsheets instead of on guests.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Connect your PMS or upload your data',
    text: 'Connect your property management system, or upload your booking history as a CSV or Excel file. The platform imports past reservations, prices and occupancy, then studies what drives bookings at your site.',
    img: '/images/data-enrichment.webp',
    alt: 'Data import and enrichment screen',
    caption: 'Import and enrichment',
  },
  {
    n: '02',
    title: 'The model finds what moves your bookings',
    text: 'Your history is matched against the weather (temperature, rain and sunshine), holiday calendars, school breaks, local events and the seasons. From that the model works out how each factor changes demand at your site, such as what a sunny weekend or a competitor price drop does to your occupancy.',
    img: '/images/price-optimization.webp',
    alt: 'Price optimisation dashboard',
    caption: 'Price optimisation',
  },
  {
    n: '03',
    title: 'Watch the competition',
    text: 'The platform finds nearby campsites within a radius you choose, using camping-and-co.com data, and monitors their prices. You see what they charge for the same dates and how full they are, and you get an alert when one of them makes a big change.',
    img: '/images/competitor-discovery.webp',
    alt: 'Competitor discovery map',
    caption: 'Competitor discovery',
  },
  {
    n: '04',
    title: 'Set the strategy',
    text: 'Pick conservative, balanced or aggressive. Then set how strongly the model should react to demand, your minimum and maximum prices, your occupancy targets, and how much weight competitor prices should carry. The model works inside those rules.',
    img: '/images/pricing-strategy.webp',
    alt: 'Pricing strategy settings',
    caption: 'Pricing strategy',
  },
  {
    n: '05',
    title: 'Manage prices on a calendar',
    text: 'Recommended prices for the next 60 days, colour coded by demand. Hover on a date to see why the model suggests that price: the forecast, competitor rates, holidays and your own history. Click to override a price, or drag across dates to change several at once.',
    img: '/images/forecasting.webp',
    alt: 'Forecast calendar with recommended prices',
    caption: 'Forecast calendar',
  },
];

const factors = [
  'Booking lead time',
  'Weather forecast',
  'Past demand',
  'Current occupancy',
  'Day of the week',
  'Season and holidays',
  'Local events',
  'School holidays',
  'Competitor rates',
  'Time until arrival',
  'Length of stay',
  'Booking pace',
];

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Dynamic Pricing', url: `${Astro.site}dynamic-pricing/` },
  ]),
  generateSoftwareApplicationSchema({
    name: 'Jengu Dynamic Pricing Engine',
    description:
      'Dynamic pricing software for campsites and holiday parks. Sets rates from demand, seasonality, weather, local events and competitor prices, within the occupancy targets and price limits you set.',
    category: 'BusinessApplication',
    isFree: false,
  }),
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Dynamic pricing">
    <Fragment slot="title">Rates that <em>follow demand.</em></Fragment>
    <p slot="lead" class="v2-lead">
      Pricing software for campsites and holiday parks. It watches demand, the season, the weather and nearby sites,
      and sets your rates each day. Nothing to pay up front, and nothing at all unless it earns you more.
    </p>
    <div slot="aside" class="dp-actions">
      <a class="v2-btn v2-btn--accent" href="https://demo.jengu.ai" target="_blank" rel="noopener noreferrer" data-magnetic>
        <span class="v2-btn__label"><span>Try the demo</span><span>Try the demo</span></span>
        <span class="v2-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
        </span>
      </a>
      <a class="v2-link" href="#how-it-works">How it works <span aria-hidden="true">→</span></a>
    </div>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="problem">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>The problem</span>
          <h2 class="v2-h2" data-split>A flat rate card <em>leaves money behind.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Most sites set their prices once a season and leave them. Demand does not sit still for that long.
          </p>
        </div>
      </div>

      <div class="v2-list">
        {
          problems.map((p) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{p.n}</span>
              <h3 class="v2-list__title">{p.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{p.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="how-it-works">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>How it works</span>
          <h2 class="v2-h2" data-split>Your data in, <em>a price for every date out.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Five steps from your booking history to a calendar of recommended prices. You keep the final say on
            every one.
          </p>
        </div>
      </div>

      <div class="v2-list">
        {
          steps.map((s) => (
            <div class="v2-list__row" data-reveal>
              <span class="v2-list__n">{s.n}</span>
              <h3 class="v2-list__title">{s.title}</h3>
              <div class="v2-list__body">
                <p class="v2-body">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="dp-gallery-space"></div>

      <span class="v2-eyebrow" data-reveal style="margin-bottom: 32px">Inside the platform</span>
      <div class="v2-gallery" data-stagger>
        {
          steps.map((s) => (
            <figure data-reveal>
              <button type="button" class="dp-zoom" onclick={`openImageModal('${s.img}')`} aria-label={`Enlarge: ${s.caption}`}>
                <img src={s.img} alt={s.alt} loading="lazy" width="1600" height="1000" />
              </button>
              <figcaption>
                {s.n} <span aria-hidden="true">·</span> {s.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="factors">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>What moves prices</span>
          <h2 class="v2-h2" data-split>Demand, season, weather, <em>competitors and events.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            Each factor is weighed against your own booking history, so the model learns what matters at your site
            rather than at a site in general.
          </p>
        </div>
      </div>

      <ul class="dp-factors" data-stagger>
        {
          factors.map((f, i) => (
            <li data-reveal>
              <span class="dp-factors__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="dp-factors__label">{f}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="pricing">
    <div class="v2-container">
      <div class="v2-split">
        <div class="v2-split__left">
          <span class="v2-eyebrow" data-reveal>What it costs</span>
          <h2 class="v2-h2" data-split>Free until it <em>earns you more.</em></h2>
          <p class="v2-lead" data-reveal>
            No setup fee and no monthly fee. We take 15% of the extra profit, measured against your revenue last year.
            If there is no extra profit, you pay nothing.
          </p>
          <div data-reveal>
            <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
              <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
              <span class="v2-btn__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
              </span>
            </button>
          </div>
        </div>

        <div class="dp-terms">
          <div class="v2-case__figures" data-reveal>
            <div class="v2-case__figure">
              <b>0</b>
              <span>Upfront cost</span>
              <small>No setup fee, no monthly fee</small>
            </div>
            <div class="v2-case__figure">
              <b>15%</b>
              <span>Of the extra profit</span>
              <small>Measured against last year</small>
            </div>
            <div class="v2-case__figure">
              <b>0</b>
              <span>Contract</span>
              <small>Cancel any time</small>
            </div>
          </div>

          <div class="dp-terms__copy" data-reveal>
            <p class="v2-body">
              You get the full platform from day one, with onboarding and support included. We only invoice once your
              revenue has passed last year’s, and only on the difference. There is no contract, so you can stop
              whenever you like.
            </p>
            <p class="v2-body">
              For a figure based on your own occupancy and rates, use the <a href="/calculator" class="dp-inline">calculator</a>
              or ask us on a call.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="light" id="start">
    <div class="v2-container">
      <div class="dp-cta">
        <span class="v2-eyebrow" data-reveal>Next step</span>
        <h2 class="v2-h2" data-split>See it running <em>on real data.</em></h2>
        <p class="v2-lead" data-reveal>
          The demo is open to anyone, with no card and no sign-up. Or book a call and we will walk through it with
          your own site’s numbers.
        </p>
        <div class="dp-actions" data-reveal>
          <a class="v2-btn v2-btn--accent" href="https://demo.jengu.ai" target="_blank" rel="noopener noreferrer" data-magnetic>
            <span class="v2-btn__label"><span>Try the demo</span><span>Try the demo</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </a>
          <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <div class="dp-modal" id="imageModal" onclick="closeImageModal()" role="dialog" aria-modal="true" aria-label="Screenshot">
    <button type="button" class="dp-modal__close" onclick="closeImageModal()" aria-label="Close">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 3l10 10M13 3L3 13" /></svg>
    </button>
    <img src="" alt="Platform screenshot" id="modalImage" />
  </div>

  <script is:inline>
    function openImageModal(src) {
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      if (!modal || !modalImg) return;
      modalImg.src = src;
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeImageModal() {
      const modal = document.getElementById('imageModal');
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeImageModal();
    });
  </script>
</V2Layout>

<style>
  .dp-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .dp-gallery-space {
    height: clamp(64px, 8vw, 128px);
  }
  .dp-zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .dp-zoom img {
    display: block;
  }
  .dp-factors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 40px;
    border-top: 1px solid var(--line);
  }
  .dp-factors li {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .dp-factors__n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .dp-factors__label {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 24px);
    letter-spacing: -0.02em;
  }
  .dp-terms {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }
  .dp-terms__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 60ch;
  }
  .dp-inline {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }
  .dp-cta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }
  .dp-modal {
    position: fixed;
    inset: 0;
    z-index: 9500;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(10, 10, 12, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    cursor: zoom-out;
  }
  .dp-modal.is-open {
    display: flex;
  }
  .dp-modal img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
  }
  .dp-modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(244, 243, 239, 0.3);
    background: none;
    color: #f4f3ef;
    cursor: pointer;
  }
  .dp-modal__close svg {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 900px) {
    .dp-factors {
      grid-template-columns: 1fr 1fr;
      gap: 0 24px;
    }
  }
  @media (max-width: 560px) {
    .dp-factors {
      grid-template-columns: 1fr;
    }
  }
</style>
