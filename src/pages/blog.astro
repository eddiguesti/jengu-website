---
/**
 * Blog index: the Jengu journal on AI in hospitality. The newest post leads,
 * then every other post gets its own row so each one has an internal link
 * from /blog (crawlability).
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  // generateSEO appends " | Jengu" itself.
  title: 'Blog & News - Latest AI Automation Insights',
  description: 'Stay updated with the latest AI automation trends, case studies, and industry insights for tourism and hospitality businesses.',
  canonical: `${Astro.site}blog/`,
  ogType: 'website'
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Blog', url: `${Astro.site}blog/` }
  ])
];

// Get all blog posts (the `news` collection is legacy and has no routes, so
// listing it here produced /news/* links that 301 to non-existent /blog/*
// pages and 404. It is intentionally excluded).
const blogPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.archived !== true;
});

// Sort by publish date (newest first)
const allContent = [...blogPosts].sort((a, b) => {
  return b.data.publishedOn.getTime() - a.data.publishedOn.getTime();
});

type BlogEntry = CollectionEntry<'blog'>;

const WORDS_PER_MINUTE = 220;

const readMinutes = (body: string): number =>
  Math.max(1, Math.round(body.trim().split(/\s+/).length / WORDS_PER_MINUTE));

const formatDate = (date: Date): string =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const toPost = (entry: BlogEntry) => ({
  title: entry.data.title,
  excerpt: entry.data.description,
  dateIso: entry.data.publishedOn.toISOString().split('T')[0],
  dateLabel: formatDate(entry.data.publishedOn),
  image: entry.data.thumbnail || entry.data.mainImage || '',
  alt: entry.data.altText || '',
  url: `/blog/${entry.slug}/`,
  readTime: readMinutes(entry.body)
});

const [leadEntry, ...restEntries] = allContent;
const lead = leadEntry ? toPost(leadEntry) : null;
const posts = restEntries.map(toPost);
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Journal" compact>
    <Fragment slot="title">Notes on AI in <em>hospitality.</em></Fragment>
    <p slot="lead" class="v2-lead">
      What we are learning about automation in hotels, campsites and holiday parks, written up as we go.
    </p>
  </V2PageHead>

  <section class="v2-section" data-theme="dark">
    <div class="v2-container">
      {lead && (
        <a href={lead.url} class="v2-post v2-post--lead" data-reveal>
          <div>
            <span class="v2-post__date">
              <time datetime={lead.dateIso}>{lead.dateLabel}</time> · {lead.readTime} min read
            </span>
            <h2 class="v2-post__title">{lead.title}</h2>
            <p class="v2-post__excerpt">{lead.excerpt}</p>
          </div>
          {lead.image ? (
            <img class="v2-post__thumb" src={lead.image} alt={lead.alt} loading="eager" decoding="async" />
          ) : (
            <span class="v2-post__thumb" aria-hidden="true"></span>
          )}
        </a>
      )}

      {posts.length > 0 && (
        <div class="v2-posts journal__list">
          {posts.map((post) => (
            <a href={post.url} class="v2-post" data-reveal>
              <span class="v2-post__date">
                <time datetime={post.dateIso}>{post.dateLabel}</time>
                <br />
                {post.readTime} min read
              </span>
              <h3 class="v2-post__title">{post.title}</h3>
              {post.image ? (
                <img class="v2-post__thumb" src={post.image} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="v2-post__thumb" aria-hidden="true"></span>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</V2Layout>

<style>
  /* The lead post already closes with a hairline, so the list does not open with one. */
  .journal__list {
    border-top: 0;
  }
  .v2-post--lead .v2-post__date {
    display: block;
    margin-bottom: 16px;
  }
  /* Posts without an image keep their column with an empty placeholder. */
  span.v2-post__thumb {
    display: block;
  }
</style>
