---
/**
 * Home — the Jengu landing page: interactive 3D concierge hero, product
 * index, Cara, results, process, FAQ and final CTA (components in
 * src/components/v2, styles in src/styles/v2, character in src/scripts/v2/robot).
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2Hero from '../components/v2/V2Hero.astro';
import V2Marquee from '../components/v2/V2Marquee.astro';
import V2Manifesto from '../components/v2/V2Manifesto.astro';
import V2Products from '../components/v2/V2Products.astro';
import V2Cara from '../components/v2/V2Cara.astro';
import V2Metrics from '../components/v2/V2Metrics.astro';
import V2Process from '../components/v2/V2Process.astro';
import V2Faq from '../components/v2/V2Faq.astro';
import V2Cta from '../components/v2/V2Cta.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateWebSiteSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'AI Automation for Tourism & Hospitality',
  description:
    'AI agents for hotels, campsites and holiday parks: guest messaging, phone bookings, dynamic pricing and integrations with your PMS. Built in London, live in weeks.',
  canonical: Astro.site?.href,
  ogType: 'website',
});

const jsonLd = [generateOrganizationSchema(), generateWebSiteSchema()];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2Hero />
  <V2Marquee />
  <V2Manifesto />
  <V2Products />
  <V2Cara />
  <V2Metrics />
  <V2Process />
  <V2Faq />
  <V2Cta />
</V2Layout>
