---
/**
 * Team: the four people at Jengu. Built on the v2 design system.
 */
import V2Layout from '../components/v2/V2Layout.astro';
import V2PageHead from '../components/v2/V2PageHead.astro';
import { generateSEO } from '../lib/seo/metadata';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo/jsonld';

const seo = generateSEO({
  title: 'Meet Our Team - AI & Tourism Automation Experts',
  description:
    'Meet the AI engineers, software developers & hospitality experts behind Jengu. Combining technical expertise with deep tourism industry knowledge to deliver results-driven automation.',
  canonical: `${Astro.site}team/`,
  ogType: 'website',
});

const jsonLd = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: Astro.site?.href || '' },
    { name: 'Team', url: `${Astro.site}team/` },
  ]),
];

const people = [
  {
    name: 'Danny Smith',
    role: 'Director',
    initials: 'DS',
    photo: '/images/team/danny-smith.webp',
    bio: 'Danny sets the direction of the company and looks after business development. He designs remote organisations that run well: he helped scale Oyster from 14 to 500 people and a $1bn valuation, and has worked as a software engineer and as COO for several tech companies.',
    linkedin: 'https://www.linkedin.com/in/dannyasmith/',
  },
  {
    name: 'Edward Guest',
    role: 'Chief Innovation Officer',
    initials: 'EG',
    bio: 'Edward leads AI strategy at Jengu and builds the automation behind the products.',
    linkedin: 'https://www.linkedin.com/in/edwardguest1/',
  },
  {
    name: 'Christopher Guest',
    role: 'Senior Process Automation Engineer',
    initials: 'CG',
    bio: 'Christopher maps business processes and designs and builds the automation workflows that replace the manual ones.',
    linkedin: 'https://www.linkedin.com/in/christopher-guest-04149551/',
  },
  {
    name: 'Lisa Mitte',
    role: 'Lead Business Process Analyst',
    initials: 'LM',
    bio: 'Lisa analyses how a business runs, finds the places where automation pays for itself and checks that each project delivers a measurable return.',
    linkedin: 'https://www.linkedin.com/in/lisa-mit-73ba25234/',
  },
];
---

<V2Layout seo={seo} jsonLd={jsonLd}>
  <V2PageHead eyebrow="Team">
    <Fragment slot="title">The people who <em>do the work.</em></Fragment>
    <p slot="lead" class="v2-lead">
      Four of us, working on AI and automation for tourism and hospitality businesses. This is who you will
      be dealing with.
    </p>
  </V2PageHead>

  <section class="v2-section" data-theme="light" id="people">
    <div class="v2-container">
      <div class="v2-people" data-stagger>
        {
          people.map((m) => (
            <div class="v2-person" data-reveal>
              {m.photo ? (
                <img class="v2-person__photo" src={m.photo} alt={m.name} width="96" height="96" loading="lazy" />
              ) : (
                <span class="v2-person__photo" aria-hidden="true">{m.initials}</span>
              )}
              <div>
                <h3>{m.name}</h3>
                <span class="v2-person__role">{m.role}</span>
                <p class="v2-body">{m.bio}</p>
                <div class="v2-person__links">
                  <a class="v2-link" href={m.linkedin} target="_blank" rel="noopener noreferrer">
                    LinkedIn <span aria-hidden="true">→</span>
                  </a>
                  <a class="v2-link" href="mailto:info@jengu.ai">Email <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="v2-section" data-theme="dark" id="work-with-us">
    <div class="v2-container">
      <div class="v2-head">
        <div>
          <span class="v2-eyebrow" data-reveal>Work with us</span>
          <h2 class="v2-h2" data-split>Engineers and <em>hospitality people.</em></h2>
        </div>
        <div class="v2-head__right">
          <p class="v2-lead" data-reveal>
            If you build software or know hospitality operations from the inside and would like to work with
            us, email us and tell us what you do.
          </p>
          <div data-reveal>
            <a class="v2-link" href="/contact">Get in touch <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</V2Layout>
