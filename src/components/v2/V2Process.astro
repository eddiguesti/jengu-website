---
const steps = [
  { n: '01', meta: 'Week 1', title: 'Look', text: 'We sit with your team and map how things really get done, then pick the job with the fastest payback.' },
  { n: '02', meta: 'Weeks 1–2', title: 'Map', text: 'We write the process down properly: where messages pile up, what gets retyped, which hours leak every week.' },
  { n: '03', meta: 'From week 2', title: 'Build', text: 'The agent goes live, connected to your PMS, booking engine, inbox and channels.' },
  { n: '04', meta: 'Ongoing', title: 'Tune', text: 'We watch every conversation and correction. The agent gets better each week, and we tell you what changed.' },
];

const pillars = [
  { title: 'Built for your property', text: 'Shaped to your workflows and your guests. No off-the-shelf package.' },
  { title: 'Live in weeks', text: 'A simple chatbot in two to three weeks. A full set of agents in eight to sixteen.' },
  { title: 'Careful with data', text: 'AES-256 encryption, GDPR compliance, role-based access and regular audits. We never sell guest data.' },
  { title: 'Only hospitality', text: 'Hotels, resorts, campsites, holiday parks, DMCs and tour operators. Nothing else.' },
];
---

<section class="v2-section" data-theme="light" id="process">
  <div class="v2-container">
    <div class="v2-process">
      <div class="v2-process__left">
        <span class="v2-eyebrow" data-reveal>How we work</span>
        <h2 class="v2-h2" data-split>One workflow first. <em>Then the rest.</em></h2>
        <p class="v2-lead" data-reveal>
          We start with a pilot: one painful job, automated and measured, before you commit to anything bigger.
        </p>
        <div data-reveal>
          <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Talk about a pilot</span><span>Talk about a pilot</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
        </div>
      </div>

      <div>
        {
          steps.map((s) => (
            <div class="v2-pstep" data-reveal>
              <span class="v2-pstep__n">{s.n}</span>
              <div>
                <span class="v2-pstep__meta">{s.meta}</span>
                <h3>{s.title}</h3>
                <p class="v2-body">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div style="height: clamp(80px, 10vw, 160px)"></div>

    <span class="v2-eyebrow" data-reveal style="margin-bottom: 32px">Why Jengu</span>
    <div class="v2-pillars" data-stagger>
      {
        pillars.map((p, i) => (
          <div class="v2-pillar" data-reveal>
            <span class="v2-pillar__n">0{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="v2-body">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
