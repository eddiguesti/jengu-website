---
const steps = [
  { n: '01', meta: 'Week 1', title: 'Discover', text: 'We map your operations and pinpoint the automations with the fastest payback for your business.' },
  { n: '02', meta: 'Weeks 1–2', title: 'Process map', text: 'We surface the hidden inefficiencies: duplicate work, bottlenecks, hours quietly leaking every week.' },
  { n: '03', meta: 'From week 2', title: 'Deploy', text: 'Custom AI agents go live, integrated with your PMS, booking engine, inbox and channels.' },
  { n: '04', meta: 'Ongoing', title: 'Optimise', text: 'They learn from every interaction and correction, sharper each week they run, monitored continuously.' },
];

const pillars = [
  { title: 'Custom built', text: 'Tailored to your workflows, guests and goals. No generic templates or off-the-shelf packages.' },
  { title: 'Fast to deploy', text: 'A first agent live in weeks: a simple chatbot in 2–3, a full automation suite in 8–16.' },
  { title: 'Enterprise-grade security', text: 'AES-256 encryption, GDPR compliance, role-based access and regular audits. We never sell your data.' },
  { title: 'Hospitality only', text: 'We build for tourism alone: hotels, resorts, campsites, holiday parks, DMCs and tour operators.' },
];
---

<section class="v2-section" data-theme="light" id="process">
  <div class="v2-container">
    <div class="v2-process">
      <div class="v2-process__left">
        <span class="v2-eyebrow" data-reveal>How we work</span>
        <h2 class="v2-h2" data-split>From first call to <em>live agents.</em></h2>
        <p class="v2-lead" data-reveal>
          A zero-risk pilot first. One painful workflow automated and measured before you commit to anything.
        </p>
        <div data-reveal>
          <button class="v2-btn" onclick="openBookingModal()" data-magnetic>
            <span class="v2-btn__label"><span>Start your free pilot</span><span>Start your free pilot</span></span>
            <span class="v2-btn__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
            </span>
          </button>
        </div>
      </div>

      <div>
        {
          steps.map((s) => (
            <div class="v2-pstep" data-reveal>
              <span class="v2-pstep__n">{s.n}</span>
              <div>
                <span class="v2-pstep__meta">{s.meta}</span>
                <h3>{s.title}</h3>
                <p class="v2-body">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div style="height: clamp(80px, 10vw, 160px)"></div>

    <span class="v2-eyebrow" data-reveal style="margin-bottom: 32px">Why Jengu</span>
    <div class="v2-pillars" data-stagger>
      {
        pillars.map((p, i) => (
          <div class="v2-pillar" data-reveal>
            <span class="v2-pillar__n">0{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="v2-body">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
