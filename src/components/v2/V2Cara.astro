---
/** Cara — the white-label guest concierge. Video frame scales in on scroll. */
const steps = [
  { title: 'Scan', line: 'One QR code at check-in. Guests land in your branded concierge on their own phone, in their language. Nothing to download.' },
  { title: 'Ask', line: 'Guests write the way they would talk to a person: “somewhere quiet for dinner tomorrow”. Cara finds it and books it.' },
  { title: 'Plan', line: 'A day-by-day itinerary built from your venues and partners. Guests swap anything with a tap and Cara redraws the plan.' },
  { title: 'Come back', line: 'Quests, a daily spin and a shared feed give guests a reason to return, without anyone on your team running it.' },
];
---

<section class="v2-section" data-theme="dark" id="cara">
  <div class="v2-container">
    <div class="v2-head">
      <div>
        <span class="v2-eyebrow" data-reveal>Product</span>
        <h2 class="v2-h2" data-split>Meet <em>Cara.</em><br />The concierge in every guest’s pocket.</h2>
      </div>
      <div class="v2-head__right">
        <p class="v2-lead" data-reveal>
          A white-label concierge guests open with one scan. It is running today at Casa Cascais in Portugal.
        </p>
      </div>
    </div>

    <div class="v2-cara__frame" data-scale-in>
      <video muted playsinline loop autoplay preload="metadata" poster="/images/jengu-cara-poster.jpg" src="/videos/jengu-cara.mp4"></video>
      <a class="v2-cara__chip" href="https://cara.jengu.ai" target="_blank" rel="noopener">Live · cara.jengu.ai ↗</a>
    </div>

    <div class="v2-cara__steps" data-stagger>
      {
        steps.map((s, i) => (
          <div class="v2-step" data-reveal>
            <span class="v2-step__n">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="v2-body">{s.line}</p>
          </div>
        ))
      }
    </div>

    <div class="v2-cara__cta" data-reveal>
      <a class="v2-btn" href="https://cara.jengu.ai" target="_blank" rel="noopener" data-magnetic>
        <span class="v2-btn__label"><span>Try the live demo</span><span>Try the live demo</span></span>
        <span class="v2-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
        </span>
      </a>
      <button class="v2-link" onclick="openBookingModal()">Ask about Cara for your property <span aria-hidden="true">→</span></button>
    </div>
  </div>
</section>
