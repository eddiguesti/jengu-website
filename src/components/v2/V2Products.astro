---
/** What we build — editorial index list with a cursor-following product visual. */
import V2ProductVisual from './V2ProductVisual.astro';

type Kind = 'chat' | 'voice' | 'pricing' | 'integrations';
const rows: { n: string; title: string; text: string; points: string[]; href: string; kind: Kind }[] = [
  {
    n: '01',
    title: 'Guest messages, answered',
    text: 'Email, chat, SMS and WhatsApp. The agent reads the question, checks availability or the house rules, and replies properly, in the guest’s language, at 2am as well as 2pm.',
    points: ['Replies in the guest’s language', 'Checks live availability', 'Hands off to a person when it should'],
    href: '/case-studies',
    kind: 'chat',
  },
  {
    n: '02',
    title: 'Phone bookings, taken',
    text: 'A voice agent that picks up every call, quotes the right rate, takes the details and puts the booking straight into your PMS. No hold music, no voicemail.',
    points: ['Picks up every call', 'Books into your PMS', 'Changes and cancellations too'],
    href: '/case-studies',
    kind: 'voice',
  },
  {
    n: '03',
    title: 'Rates that follow demand',
    text: 'Pricing that moves with demand, the season and what the competition charges. Built for campsites and holiday parks. You pay only when it earns you more.',
    points: ['Watches demand and competitors', 'Adjusts daily', 'Paid on results'],
    href: '/dynamic-pricing',
    kind: 'pricing',
  },
  {
    n: '04',
    title: 'Your systems, talking to each other',
    text: 'Opera, Mews, Cloudbeds, Booking.com, Expedia, Airbnb, your CRM and your payments. We connect them so nobody retypes a reservation again.',
    points: ['PMS and channel managers', 'OTAs and booking engines', 'Custom connections'],
    href: '/services',
    kind: 'integrations',
  },
];
---

<section class="v2-section" data-theme="light" id="build">
  <div class="v2-container">
    <div class="v2-head">
      <div>
        <span class="v2-eyebrow" data-reveal>What we build</span>
        <h2 class="v2-h2" data-split>Agents for the jobs <em>that eat your day.</em></h2>
      </div>
      <div class="v2-head__right">
        <p class="v2-lead" data-reveal>
          Guest messages, phone bookings, rate changes and the copy-paste between systems. Each one built around
          how your property already runs, for hotels, resorts, campsites, holiday parks and tour operators.
        </p>
      </div>
    </div>

    <div class="v2-index">
      {
        rows.map((r) => (
          <a class="v2-row" href={r.href} data-reveal>
            <span class="v2-row__num">{r.n}</span>
            <h3 class="v2-h3 v2-row__title">{r.title}</h3>
            <div class="v2-row__body">
              <p class="v2-body">{r.text}</p>
              <ul class="v2-row__points">
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
            <span class="v2-row__arrow" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 15L15 3M6 3h9v9" />
              </svg>
            </span>
            <div class="v2-row__thumb">
              <V2ProductVisual kind={r.kind} />
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div class="v2-follower" aria-hidden="true">
    {
      rows.map((r) => (
        <div class="v2-follower__item">
          <V2ProductVisual kind={r.kind} />
        </div>
      ))
    }
  </div>
</section>
