---
---

<section class="v2-cta" data-theme="dark" id="start">
  <video muted playsinline loop autoplay preload="metadata" src="/videos/jengu-calm.mp4" aria-hidden="true"></video>
  <div class="v2-cta__inner">
    <span class="v2-eyebrow" data-reveal>Start with a pilot</span>
    <h2 class="v2-h1" data-split>Let the inbox run itself <em>for a month.</em></h2>
    <p class="v2-lead" data-reveal style="text-align: center; max-width: 52ch">
      Guests answered, bookings confirmed, problems caught overnight. One workflow, measured, and no
      commitment beyond that.
    </p>
    <div class="v2-cta__actions" data-reveal>
      <button class="v2-btn v2-btn--accent" onclick="openBookingModal()" data-magnetic>
        <span class="v2-btn__label"><span>Book a call</span><span>Book a call</span></span>
        <span class="v2-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13L13 3M5 3h8v8" /></svg>
        </span>
      </button>
      <a href="mailto:info@jengu.ai" class="v2-link">or just email us <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
