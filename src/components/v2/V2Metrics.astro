---
/**
 * The problem, in numbers. Third-party figures only, each with its source,
 * so nothing here is a claim we would have to defend ourselves.
 */
const metrics = [
  {
    value: 76,
    pre: '',
    suffix: '%',
    title: 'of travellers prefer to book in their own language',
    text: 'CSA Research asked 8,709 consumers across 29 countries. Four in ten will not buy from a site in another language at all.',
    source: 'CSA Research, 2020',
    href: 'https://csa-research.com/Blogs-Events/CSA-in-the-Media/Press-Releases/Consumers-Prefer-their-Own-Language',
  },
  {
    value: 65,
    pre: '',
    suffix: '%',
    title: 'of hotels cannot fill their open roles',
    text: 'Nearly two thirds of hotels surveyed in January 2025 were short-staffed. Front desk was the second hardest job to fill.',
    source: 'AHLA and Hireology, 2025',
    href: 'https://www.ahla.com/news/65-surveyed-hotels-report-staffing-shortages',
  },
  {
    value: 7,
    pre: '',
    suffix: '×',
    title: 'more likely to win an enquiry answered within the hour',
    text: 'Firms that replied to a new enquiry inside an hour were about seven times as likely to qualify it as those that waited longer.',
    source: 'Harvard Business Review',
    href: 'https://hbr.org/2011/03/the-short-life-of-online-sales-leads',
  },
];
---

<section class="v2-section" data-theme="dark" id="results">
  <div class="v2-container">
    <div class="v2-head">
      <div>
        <span class="v2-eyebrow" data-reveal>Why now</span>
        <h2 class="v2-h2" data-split>The problem, <em>in numbers.</em></h2>
      </div>
      <div class="v2-head__right">
        <p class="v2-lead" data-reveal>
          None of these are ours. They are the figures the industry keeps quoting, and the reasons owners call us.
        </p>
      </div>
    </div>

    <div class="v2-metrics" data-stagger>
      {
        metrics.map((m) => (
          <div class="v2-metric" data-reveal>
            <div class="v2-metric__n">
              {m.pre && <span class="pre">{m.pre}</span>}
              <span data-count={m.value}>0</span>
              <small>{m.suffix}</small>
            </div>
            <h3>{m.title}</h3>
            <p class="v2-body">{m.text}</p>
            <a class="v2-metric__src" href={m.href} target="_blank" rel="noopener">
              Source: {m.source} ↗
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
